from pathlib import Path
import csv
import random

from openpyxl import Workbook

OUTPUT_DIR = Path.cwd()
N_SCENARIOS = 50
N_ORS = 10
OPEN_TIME = 0
CLOSE_TIME = 600
OVERTIME_CAP = 120
H = CLOSE_TIME + OVERTIME_CAP          
TURNOVER = 15
BREAK = 30
MAX_OPS_PER_SURGEON = 3                # the workbook has 3 operation columns
MAX_SURGEON_LOAD = 540                 # sum(max duration) + breaks + unavailable window must stay below this
ANCHOR_SLOTS = [0, 60, 120, 180, 240, 300, 360, 420, 480]
UNAVAIL_STARTS = [0, 60, 120, 180, 240, 300]
UNAVAIL_LENGTHS = [60, 120, 180]
MAX_ATTEMPTS = 300                     # redraws per instance
VALIDATION_TRIES = 600                 # random chromosomes used to prove feasibility
MIN_FEASIBLE_RATE = 0.05               # >= 5 % of random chromosomes must be feasible (Instance 10: ~31 %)

# (surgeons, operations, CS, favourable, unfavourable, OR requests, start requests)
INSTANCE_SPECS = {
    11: (12, 27, 2, 22, 26, 2, 3),
    12: (15, 31, 3, 27, 30, 4, 2),
    13: (11, 24, 1, 19, 23, 2, 2),
    14: (16, 33, 3, 28, 32, 4, 4),
    15: (14, 29, 4, 25, 29, 3, 3),
    16: (10, 18, 1, 12, 17, 1, 1),
    17: (17, 34, 2, 29, 33, 4, 3),
    18: (13, 26, 2, 22, 25, 2, 4),
    19: (15, 30, 1, 25, 29, 3, 2),
    20: (12, 28, 3, 23, 27, 3, 3),
}


# ----------------------------------------------------------------------------------------------
# 1. Random data (same distributions as the article, Section 6.2)
# ----------------------------------------------------------------------------------------------
def lognormal_scenarios(rng, is_cs):
    mu = rng.uniform(4.5, 5.0) if is_cs else rng.uniform(3.0, 5.0)
    sigma = rng.uniform(0.05, 0.30)
    return [max(20, min(240, int(round(rng.lognormvariate(mu, sigma))))) for _ in range(N_SCENARIOS)]


def balanced_assignments(rng, n_ops, n_surgeons, cs_ops):
    cs_set = set(cs_ops)
    for _ in range(5000):
        loads = {s: 0 for s in range(1, n_surgeons + 1)}
        team, ok = {}, True
        ops = list(range(1, n_ops + 1))
        rng.shuffle(ops)
        for op in ops:
            need = 2 if op in cs_set else 1
            cand = sorted((s for s in loads if loads[s] < MAX_OPS_PER_SURGEON), key=lambda s: (loads[s], rng.random()))
            if len(cand) < need:
                ok = False
                break
            team[op] = cand[:need]
            for s in team[op]:
                loads[s] += 1
        if ok:
            return team
    raise RuntimeError("Cannot allocate operations with <= 3 per surgeon: add surgeons or remove operations.")


def segments(inst, op, w, start):
    """[(surgeon, seg_start, seg_end)] of surgery `op` in scenario w if it starts at `start`."""
    team = inst["team"][op]
    tot = inst["p"][op][w]
    if len(team) == 1:
        return [(team[0], start, start + tot)]
    p1 = inst["part1"][op][w]
    return [(team[0], start, start + p1), (team[1], start + p1, start + tot)]


# ----------------------------------------------------------------------------------------------
# 2. Draw one candidate instance (feasibility by construction where possible)
# ----------------------------------------------------------------------------------------------
def draw_instance(spec, rng):
    n_surg, n_ops, n_cs, n_fav, n_unfav, n_or_req, n_start_req = spec
    if n_fav + n_unfav > n_surg * N_ORS or max(n_or_req, n_start_req, n_cs) > n_ops:
        raise ValueError("Inconsistent instance specification.")

    inst = dict(n_surg=n_surg, n_ops=n_ops)
    cs_ops = sorted(rng.sample(range(1, n_ops + 1), n_cs))
    inst["cs_ops"] = cs_ops
    inst["team"] = balanced_assignments(rng, n_ops, n_surg, cs_ops)

    # eligibility a (>= 8 eligible ORs per surgeon, so every team shares >= 6 ORs)
    a = []
    for _ in range(n_surg):
        row = [1] * N_ORS
        for k in rng.sample(range(N_ORS), rng.randint(0, 2)):
            row[k] = 0
        a.append(row)
    inst["a"] = a

    # preferences b / c
    cells = [(s, k) for s in range(n_surg) for k in range(N_ORS)]
    rng.shuffle(cells)
    fav = [(s, k) for s, k in cells if a[s][k] == 1][:n_fav]
    if len(fav) < n_fav:
        raise ValueError("Not enough eligible cells for favourable conditions.")
    fav_set = set(fav)
    unfav = [(s, k) for s, k in cells if (s, k) not in fav_set][:n_unfav]
    b = [[0] * N_ORS for _ in range(n_surg)]
    c = [[0] * N_ORS for _ in range(n_surg)]
    for s, k in fav:
        b[s][k] = 1
    for s, k in unfav:
        c[s][k] = 1
    inst["b"], inst["c"] = b, c

    # durations; CS split into part 1 (first surgeon) and part 2 (second surgeon), sequential (Fig. 1c)
    inst["p"], inst["part1"] = {}, {}
    for op in range(1, n_ops + 1):
        tot = lognormal_scenarios(rng, op in cs_ops)
        inst["p"][op] = tot
        if op in cs_ops:
            inst["part1"][op] = [max(10, min(t - 10, int(round(t * rng.uniform(0.25, 0.65))))) for t in tot]

    # surgeon unavailable windows: must leave enough room for the surgeon's own workload
    surg_ops = {n: [op for op in range(1, n_ops + 1) if n in inst["team"][op]] for n in range(1, n_surg + 1)}
    inst["unavail"] = {}
    for n in range(1, n_surg + 1):
        work = 0
        for op in surg_ops[n]:
            if op in cs_ops:
                idx = inst["team"][op].index(n)
                work += max(inst["part1"][op]) if idx == 0 else max(t - q for t, q in zip(inst["p"][op], inst["part1"][op]))
            else:
                work += max(inst["p"][op])
        work += BREAK * max(0, len(surg_ops[n]) - 1)
        options = [(s, l) for s in UNAVAIL_STARTS for l in UNAVAIL_LENGTHS
                   if s + l <= CLOSE_TIME and work + l <= MAX_SURGEON_LOAD]
        s, l = rng.choice(options) if options else (0, 0)
        inst["unavail"][n] = (s, s + l)

    # requested ORs (always an OR eligible for ALL surgeons of the team)
    inst["req_OR"] = {}
    for op in rng.sample(range(1, n_ops + 1), n_or_req):
        ok = [k for k in range(1, N_ORS + 1) if all(a[s - 1][k - 1] == 1 for s in inst["team"][op])]
        inst["req_OR"][op] = rng.choice(ok)

    # requested start times: only conflict-free ones
    inst["req_start"] = {}
    used_surgeons, used_or = set(), set()
    order = list(range(1, n_ops + 1))
    rng.shuffle(order)
    for op in order:
        if len(inst["req_start"]) == n_start_req:
            break
        team = inst["team"][op]
        if used_surgeons & set(team):
            continue
        if op in inst["req_OR"] and inst["req_OR"][op] in used_or:
            continue
        slots = ANCHOR_SLOTS[:]
        rng.shuffle(slots)
        for t in slots:
            good = True
            for w in range(N_SCENARIOS):
                if t + inst["p"][op][w] > CLOSE_TIME:               # keep anchors inside the regular day
                    good = False
                    break
                for n, s0, s1 in segments(inst, op, w, t):
                    lo, hi = inst["unavail"][n]
                    if hi > lo and min(s1, hi) > max(s0, lo):       # overlap with unavailable window
                        good = False
                        break
                if not good:
                    break
            if good:
                inst["req_start"][op] = t
                used_surgeons |= set(team)
                if op in inst["req_OR"]:
                    used_or.add(inst["req_OR"][op])
                break
    if len(inst["req_start"]) < n_start_req:
        raise ValueError("Could not place all requested starts without conflict.")

    inst["elig"] = {}
    for op in range(1, n_ops + 1):
        e = [k for k in range(1, N_ORS + 1) if all(a[s - 1][k - 1] == 1 for s in inst["team"][op])]
        inst["elig"][op] = [inst["req_OR"][op]] if op in inst["req_OR"] else e
    return inst


# ----------------------------------------------------------------------------------------------
# 3. Validation: constructive decoder with the same semantics as the notebook (anchors first)
# ----------------------------------------------------------------------------------------------
def _earliest_free(lb, forbidden):
    s, moved = lb, True
    while moved:
        moved = False
        for lo, hi in forbidden:
            if lo < s < hi:
                s, moved = hi, True
    return s


def scenario_violation(inst, assign, order, w):
    """Total violation (minutes) of the greedy schedule in scenario w; 0.0 means feasible."""
    or_busy = {k: [] for k in range(1, N_ORS + 1)}
    surg_busy = {n: [] for n in range(1, inst["n_surg"] + 1)}
    unav = {n: ([inst["unavail"][n]] if inst["unavail"][n][1] > inst["unavail"][n][0] else [])
            for n in range(1, inst["n_surg"] + 1)}
    viol = 0.0

    def place(op, forced):
        k = assign[op]
        team = inst["team"][op]
        tot = inst["p"][op][w]
        if len(team) == 1:
            zones = [(or_busy[k], 0, tot, TURNOVER), (surg_busy[team[0]], 0, tot, BREAK), (unav[team[0]], 0, tot, 0)]
        else:
            p1 = inst["part1"][op][w]
            zones = [(or_busy[k], 0, tot, TURNOVER),
                     (surg_busy[team[0]], 0, p1, BREAK), (unav[team[0]], 0, p1, 0),
                     (surg_busy[team[1]], p1, tot - p1, BREAK), (unav[team[1]], p1, tot - p1, 0)]
        if forced is not None:
            s, conflict = forced, 0.0
            for busy, off, d, buf in zones:
                for bs, be in busy:
                    lo, hi = max(s + off, bs - buf), min(s + off + d, be + buf)
                    if hi > lo:
                        conflict += hi - lo
        else:
            forb = [(bs - buf - off - d, be + buf - off) for busy, off, d, buf in zones for bs, be in busy]
            s, conflict = _earliest_free(OPEN_TIME, forb), 0.0
        fin = s + tot
        or_busy[k].append((s, fin))
        if len(team) == 1:
            surg_busy[team[0]].append((s, fin))
        else:
            surg_busy[team[0]].append((s, s + inst["part1"][op][w]))
            surg_busy[team[1]].append((s + inst["part1"][op][w], fin))
        return max(0.0, fin - H) + conflict

    for op in [o for o in order if o in inst["req_start"]]:
        viol += place(op, inst["req_start"][op])
        if viol > 0:
            return viol
    for op in [o for o in order if o not in inst["req_start"]]:
        viol += place(op, None)
        if viol > 0:
            return viol
    return viol


def feasibility_rate(inst, rng, tries=VALIDATION_TRIES):
    ok = 0
    ops = list(range(1, inst["n_ops"] + 1))
    for _ in range(tries):
        assign = {op: rng.choice(inst["elig"][op]) for op in ops}
        order = ops[:]
        rng.shuffle(order)
        if all(scenario_violation(inst, assign, order, w) == 0 for w in range(N_SCENARIOS)):
            ok += 1
    return ok / tries


# ----------------------------------------------------------------------------------------------
# 4. Excel writer (same sheet names / layout the notebook loader reads)
# ----------------------------------------------------------------------------------------------
def sc(values):
    return ", ".join(str(int(v)) for v in values)


def write_workbook(inst, path, seed, rate):
    n_s, n_o = inst["n_surg"], inst["n_ops"]
    wb = Workbook()
    ws = wb.active
    ws.title = "Sheet"
    ws.append(["Operations", n_o])
    ws.append(["Surgeons", n_s])

    ws = wb.create_sheet("Cooperat_Oper")
    ws.append(["Cooperative_Operations"])
    for op in inst["cs_ops"]:
        ws.append([op])

    ws = wb.create_sheet("Requested_Start")
    ws.append(["Operation", "Requested_StartTime"])
    for op in sorted(inst["req_start"]):
        ws.append([op, inst["req_start"][op]])

    ws = wb.create_sheet("Opera_By_Surgeon")
    ws.append(["Surgeon", "Operation 1", "Operation 2", "Operation 3"])
    for n in range(1, n_s + 1):
        ops = sorted(op for op in range(1, n_o + 1) if n in inst["team"][op])
        ws.append([n] + ops + [None] * (MAX_OPS_PER_SURGEON - len(ops)))

    for name in ("a", "b", "c"):
        ws = wb.create_sheet(name)
        for row in inst[name]:
            ws.append(row)

    ws = wb.create_sheet("p_matrix")
    ws.append(["Duration"])
    for op in range(1, n_o + 1):
        ws.append([sc(inst["p"][op])])

    pc_rows = [[None] + list(range(1, n_s + 1))]
    po_rows = [[None] + list(range(1, n_s + 1))]
    for op in inst["cs_ops"]:
        n1, n2 = inst["team"][op]
        p1 = inst["part1"][op]
        p2 = [t - q for t, q in zip(inst["p"][op], p1)]
        r = [[op] + [None] * n_s for _ in range(4)]
        r[0][n1] = sc(p1)
        r[1][n2] = sc(p2)
        r[2][n1] = sc([0] * N_SCENARIOS)
        r[3][n2] = sc(p1)
        pc_rows += [r[0], r[1]]
        po_rows += [r[2], r[3]]
    ws = wb.create_sheet("pc_matrix")
    for r in pc_rows:
        ws.append(r)

    ws = wb.create_sheet("Unavailable_Time")
    ws.append(["Surgeon", "Start", "End"])
    for n in range(1, n_s + 1):
        ws.append([n, *inst["unavail"][n]])

    ws = wb.create_sheet("po_matrix")
    for r in po_rows:
        ws.append(r)

    ws = wb.create_sheet("r_matrix")
    ws.append([None] + [f"OR {k}" for k in range(1, N_ORS + 1)])
    for op in range(1, n_o + 1):
        row = [f"Operation {op}"] + [0] * N_ORS
        if op in inst["req_OR"]:
            row[inst["req_OR"][op]] = 1
        ws.append(row)

    ws = wb.create_sheet("Opening_Time")
    ws.append(["OR", "Open", "Desired_Close_Time"])
    for k in range(1, N_ORS + 1):
        ws.append([k, OPEN_TIME, CLOSE_TIME])

    wb.properties.title = f"Synthetic OR Scheduling Instance {path.stem.split()[-1]}"
    wb.properties.description = (f"Synthetic instance (generator v2, feasibility-validated). Seed {seed}; "
                                 f"{N_SCENARIOS} scenarios; random-chromosome feasibility rate {rate:.3f}.")
    wb.save(path)


# ----------------------------------------------------------------------------------------------
def generate(instance_id, spec):
    for attempt in range(MAX_ATTEMPTS):
        seed = 20261031 + instance_id * 1009 + attempt * 7919
        rng = random.Random(seed)
        try:
            inst = draw_instance(spec, rng)
        except ValueError:
            continue
        rate = feasibility_rate(inst, random.Random(seed + 1))
        if rate >= MIN_FEASIBLE_RATE:
            return inst, seed, rate, attempt + 1
    raise RuntimeError(f"Instance {instance_id}: no valid draw after {MAX_ATTEMPTS} attempts "
                       f"(relax the specification or MIN_FEASIBLE_RATE).")


def main():
    report = []
    for instance_id, spec in INSTANCE_SPECS.items():
        inst, seed, rate, attempts = generate(instance_id, spec)
        out = OUTPUT_DIR / f"Instance {instance_id}.xlsx"
        write_workbook(inst, out, seed, rate)
        print(f"Created {out.name}: seed={seed}, attempts={attempts}, random-chromosome feasibility={rate:.1%}, "
              f"anchors={dict(sorted(inst['req_start'].items()))}")
        report.append(dict(instance=instance_id, seed=seed, attempts=attempts, feasible_rate=round(rate, 4),
                           surgeons=spec[0], operations=spec[1], CS=spec[2], fav=spec[3], unfav=spec[4],
                           req_OR=spec[5], req_start=spec[6]))
    with open(OUTPUT_DIR / "generation_report.csv", "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=list(report[0]))
        w.writeheader()
        w.writerows(report)
    print("\nFinished. Keep this script, the seeds and generation_report.csv with your dataset.")


if __name__ == "__main__":
    main()
